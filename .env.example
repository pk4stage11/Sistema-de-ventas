# Copia este archivo a .env.local y completa los valores reales.
# Nunca commitees .env.local — ya está en .gitignore.

# ── Supabase ──────────────────────────────────────────────────────────────
# Panel del proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role: solo en el servidor. Nunca en código con "use client" ni en NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (Claude) ───────────────────────────────────────────────────
# console.anthropic.com → API Keys. Requerida desde la Fase 4: sin una key
# real, el agente falla al llamar a Claude (queda logueado, no rompe la
# ingesta) pero nunca responde de verdad.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# ── Meta (WhatsApp Cloud API / Messenger / Instagram) ───────────────────
# Meta for Developers → tu app → Settings → Basic → App Secret
META_APP_SECRET=
# Token propio que defines tú; debe coincidir con el que registras en el
# webhook de Meta al verificar con GET (hub.verify_token).
META_WEBHOOK_VERIFY_TOKEN=
# WhatsApp Cloud API → tu número de prueba o de producción
WHATSAPP_PHONE_NUMBER_ID=
# Token de acceso de la app (usar uno de larga duración en producción)
WHATSAPP_ACCESS_TOKEN=

# ── Google Calendar (agenda de visitas) ─────────────────────────────────
# Google Cloud Console → Credenciales → ID de cliente de OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir exactamente con el registrado en Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Clave de 32 bytes en hexadecimal (64 caracteres) para cifrar el refresh
# token de Google antes de guardarlo. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Cron / cola de background ───────────────────────────────────────────
# Secreto que Vercel Cron envía en el header Authorization al llamar
# /api/cron/drain. Generar con el mismo comando que ENCRYPTION_KEY.
CRON_SECRET=
